# Default provider: OpenRouter (cheap OpenAI-compatible models)
OPENROUTER_API_KEY=sk-or-...
# Optional: OpenRouter attribution headers
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=job-agent

# Optional: direct OpenAI provider
OPENAI_API_KEY=sk-...
# Optional: Hugging Face provider
HF_API_KEY=hf_...
# Optional: only needed if you use a Google provider
GOOGLE_API_KEY=